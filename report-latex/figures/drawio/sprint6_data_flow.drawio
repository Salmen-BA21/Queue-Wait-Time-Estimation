        <mxCell id="ack" value="Acknowledge only\n(no outbound alert)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1720" y="320" width="170" height="90" as="geometry" /></mxCell>

