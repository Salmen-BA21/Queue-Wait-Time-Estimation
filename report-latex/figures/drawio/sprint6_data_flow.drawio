        <mxCell id="unauth" value="Reject 401" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="1490" y="140" width="170" height="80" as="geometry" /></mxCell>

