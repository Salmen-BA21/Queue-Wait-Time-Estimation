entity-relationship-diagram

colorMode bold
styleMode plain
typeface clean
notation crows-feet

establishments [icon: database, color: blue] {
  id int pk
  name string not null unique
  address string
  created_at timestamp
}

caisses [icon: database, color: green] {
  id int pk
  name string not null
  establishment_id int fk not null
  camera_id string
  is_active boolean
  created_at timestamp
}

queue_sessions [icon: database, color: orange] {
  id int pk
  caisse_id int fk
  started_at timestamp
  ended_at timestamp
  status string
  created_at timestamp
}

feed_configs [icon: database, color: red] {
  id int pk
  caisse_id int fk
  source_url string
  zone_points_json json
  is_enabled boolean
  created_at timestamp
}

queue_alerts [icon: database, color: orange] {
  id int pk
  queue_session_id int fk
  severity string
  alert_type string
  value float
  threshold float
  created_at timestamp
}

establishments.id < caisses.establishment_id
caisses.id < queue_sessions.caisse_id
caisses.id < feed_configs.caisse_id
queue_sessions.id < queue_alerts.queue_session_id
